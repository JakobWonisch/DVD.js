{
  "name": "dvd.js",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Convert and play DVD menus in the browser for long-term preservation",
  "author": "G. C. Marty",
  "license": "GPL-3.0",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm build:viewer",
    "build:viewer": "vite build --config viewer/vite.config.ts",
    "dev:viewer": "vite --config viewer/vite.config.ts",
    "watch": "tsc -p tsconfig.json --watch",
    "watch:viewer": "vite build --watch --config viewer/vite.config.ts",
    "start": "node ./bin/start.js",
    "start:server": "node ./bin/http-server.js",
    "convert": "node ./bin/convert.js",
    "pack-discs": "node ./bin/convert.js -- --pack-only",
    "reconvert": "bash ./scripts/reconvert.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:dvdnav-oracle": "make -C tools/dvdnav-oracle",
    "test:vm-oracle": "pnpm build:dvdnav-oracle && vitest run tests/vm/oracle",
    "nav-oracle": "pnpm build:dvdnav-oracle && node --experimental-strip-types ./scripts/nav-oracle.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p viewer/tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gmarty/DVD.js.git"
  },
  "keywords": [
    "dvd",
    "libdvdnav",
    "libdvdread",
    "interoperability",
    "preservation"
  ],
  "dependencies": {
    "@solidjs/router": "^1.0.0",
    "connect": "^3.7.0",
    "cors": "^2.8.5",
    "eventemitter3": "^5.0.1",
    "jdataview": "^2.5.0",
    "lodash": "^4.17.21",
    "mdns-js": "^1.0.3",
    "serve-static": "^1.16.2",
    "solid-js": "^1.9.15",
    "vault66-crt-effect": "^3.1.1"
  },
  "devDependencies": {
    "@types/connect": "^3.4.38",
    "@types/cors": "^2.8.19",
    "@types/lodash": "^4.17.20",
    "@types/node": "^24.13.6",
    "@types/serve-static": "^1.15.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.2"
  }
}
