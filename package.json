{
  "name": "dvd.js",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Convert and play DVD menus in the browser for long-term preservation",
  "author": "G. C. Marty",
  "license": "GPL-3.0",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "start": "node ./bin/http-server.js",
    "convert": "node ./bin/convert.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gmarty/DVD.js.git"
  },
  "keywords": [
    "dvd",
    "libdvdnav",
    "libdvdread",
    "interoperability",
    "preservation"
  ],
  "dependencies": {
    "connect": "^3.7.0",
    "cors": "^2.8.5",
    "eventemitter3": "^5.0.1",
    "jdataview": "^2.5.0",
    "lodash": "^4.17.21",
    "mdns-js": "^1.0.3",
    "serve-static": "^1.16.2"
  },
  "devDependencies": {
    "@types/connect": "^3.4.38",
    "@types/cors": "^2.8.19",
    "@types/lodash": "^4.17.20",
    "@types/node": "^24.13.6",
    "@types/serve-static": "^1.15.8",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
