# Host port published by Compose (container always listens on 3000).
DVD_MENU_ARCHIVE_HOST_PORT=3000

# Host path (or named volume) mounted at /data/web inside the container.
# Place converted `<discId>.tar.gz` archives (+ `*.cover.jpg`) here.
DVD_MENU_ARCHIVE_WEB_VOLUME=./web

# Run the container as the host owner of DVD_MENU_ARCHIVE_WEB_VOLUME so archives
# can be extracted and cache markers written. Use: id -u  /  id -g
DVD_MENU_ARCHIVE_UID=1000
DVD_MENU_ARCHIVE_GID=1000

# Drop decompressed disc folders after 1h idle (archives kept). Recommended on servers.
DVD_MENU_ARCHIVE_EVICT_DISC_CACHE=true

# Optional: absolute/relative path to a JSON config mounted into the container.
# Prefer the env vars above for Compose; use this to share a host config/app.json.
# DVD_MENU_ARCHIVE_CONFIG_FILE=./config/app.json

# Legacy DVDJS_* names are still accepted by the Node server if set instead.

# Viewer “Report a problem” session logs (defaults under webFolder).
# DVD_MENU_ARCHIVE_REPORTS_FOLDER=./web/.dvd-menu-archive-reports
# DVD_MENU_ARCHIVE_REPORTS_MAX_COUNT=100
# DVD_MENU_ARCHIVE_REPORTS_MAX_TOTAL_BYTES=52428800
# DVD_MENU_ARCHIVE_REPORTS_MAX_BODY_BYTES=524288

# TMDB API key for catalogue posters (convert + --posters-only). Free
# non-commercial key from https://www.themoviedb.org/settings/api —
# viewer shows required attribution when posters are used.
# DVD_MENU_ARCHIVE_TMDB_API_KEY=
